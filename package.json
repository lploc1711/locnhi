{
  "name": "locnhi",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:login": "firebase login",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting --project plocandnhi",
