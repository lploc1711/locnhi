{
  "rules": {
    ".read": false,
    ".write": false,
    "heartBlocks": {
      "$code": {
        ".read": "auth != null && (auth.uid === root.child('heartBlocks').child($code).child('host').val() || auth.uid === root.child('heartBlocks').child($code).child('guest').val())",
        ".write": "auth != null && $code.matches(/^[0-9a-f]{24}$/) && !data.exists() && newData.child('host').val() === auth.uid && newData.child('round').val() === 1 && !newData.child('guest').exists() && !newData.child('matches').exists()",
        ".validate": "newData.hasChildren(['host','round','createdAt'])",
        "host": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "guest": {
          ".write": "auth != null && root.child('heartBlocks').child($code).child('host').exists() && !data.exists() && auth.uid !== root.child('heartBlocks').child($code).child('host').val() && newData.val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "round": {
          ".write": "(auth != null && (auth.uid === root.child('heartBlocks').child($code).child('host').val() || auth.uid === root.child('heartBlocks').child($code).child('guest').val())) && root.child('heartBlocks').child($code).child('guest').exists() && newData.val() === data.val() + 1 && root.child('heartBlocks').child($code).child('matches').child('' + data.val()).child('ready').child(root.child('heartBlocks').child($code).child('host').val()).val() === true && root.child('heartBlocks').child($code).child('matches').child('' + data.val()).child('ready').child(root.child('heartBlocks').child($code).child('guest').val()).val() === true",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
        },
        "matches": {
          "$round": {
            "logs": {
              "$uid": {
                ".write": "((auth != null && (auth.uid === root.child('heartBlocks').child($code).child('host').val() || auth.uid === root.child('heartBlocks').child($code).child('guest').val())) && root.child('heartBlocks').child($code).child('guest').exists() && $round === ('' + root.child('heartBlocks').child($code).child('round').val())) && auth.uid === $uid && newData.isString() && !((root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('host').val()).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('host').val()).val().endsWith('!')) || (root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('guest').val()).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('guest').val()).val().endsWith('!')))",
                ".validate": "newData.val().length <= 4097 && newData.val().matches(/^([012][A-Za-z0-9_-])*[.!]?$/) && ((!data.exists() && (newData.val().length === 2 || newData.val() === '!')) || (data.isString() && !data.val().endsWith('.') && !data.val().endsWith('!') && newData.val().beginsWith(data.val()) && ((newData.val().length === data.val().length + 2 && !newData.val().endsWith('!') && !newData.val().endsWith('.')) || (newData.val().length === data.val().length + 3 && newData.val().endsWith('.')) || (newData.val().length === data.val().length + 1 && newData.val().endsWith('!')))))"
              }
            },
            "ready": {
              "$uid": {
                ".write": "((auth != null && (auth.uid === root.child('heartBlocks').child($code).child('host').val() || auth.uid === root.child('heartBlocks').child($code).child('guest').val())) && root.child('heartBlocks').child($code).child('guest').exists() && $round === ('' + root.child('heartBlocks').child($code).child('round').val())) && auth.uid === $uid && newData.val() === true && ((root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child($uid).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child($uid).val().endsWith('.')) || ((root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('host').val()).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('host').val()).val().endsWith('!')) || (root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('guest').val()).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('guest').val()).val().endsWith('!'))) || ((root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('host').val()).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('host').val()).val().endsWith('.')) && (root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('guest').val()).isString() && root.child('heartBlocks').child($code).child('matches').child($round).child('logs').child(root.child('heartBlocks').child($code).child('guest').val()).val().endsWith('.'))))",
                ".validate": "newData.isBoolean()"
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$uid": {
        "datePlans": {
          ".read": "auth != null && auth.uid === $uid",
          "$planId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['title', 'date', 'location', 'note', 'done', 'createdAt']) && (data.exists() || newData.child('done').val() === false)",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().matches(/.*[^ \\t\\r\\n].*/)"
            },
            "date": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
            },
            "location": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
